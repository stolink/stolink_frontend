#!/bin/sh
# Husky pre-push hook

# 환경 설정 - PATH 확장
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# NVM 로드 (여러 경로 시도)
load_nvm() {
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh" --no-use >/dev/null 2>&1
    nvm use >/dev/null 2>&1 || true
    return 0
  elif [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
    . "/opt/homebrew/opt/nvm/nvm.sh" --no-use >/dev/null 2>&1
    nvm use >/dev/null 2>&1 || true
    return 0
  fi
  return 1
}

# NVM 로드 시도 (실패해도 계속 진행)
load_nvm || true

# Node 확인
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  Node.js not found in PATH"

  # Homebrew node 직접 사용
  if [ -x "/opt/homebrew/bin/node" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -x "/usr/local/bin/node" ]; then
    export PATH="/usr/local/bin:$PATH"
  fi
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "🔍 Pushing to: $BRANCH"
echo "   Node: $(which node 2>/dev/null || echo 'not found')"

# 모든 브랜치: 타입 체크
echo "Running type check..."
npm run type-check || exit 1

# main, release 브랜치: 더 엄격한 검증
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "release" ]; then
  echo "🚨 Protected branch detected. Running full checks..."

  # 전체 린트
  npm run lint || exit 1

  echo "✅ All checks passed!"
fi

# release 브랜치: 직접 푸시 금지
if [ "$BRANCH" = "release" ]; then
  echo "⛔ Direct push to release is not allowed!"
  echo "Please create a PR from main to release."
  exit 1
fi

echo "✅ Pre-push checks completed!"
