# 환경 설정 로드
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# NVM 로드
if [ -f "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
elif [ -f "/opt/homebrew/opt/nvm/nvm.sh" ]; then
  . "/opt/homebrew/opt/nvm/nvm.sh"
fi

# Zsh 설정 로드
[ -f "$HOME/.zshrc" ] && . "$HOME/.zshrc" >/dev/null 2>&1

BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "🔍 Pushing to: $BRANCH"

# 모든 브랜치: 타입 체크
echo "Running type check..."
npm run type-check || exit 1

# main, release 브랜치: 더 엄격한 검증
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "release" ]; then
  echo "🚨 Protected branch detected. Running full checks..."

  # 전체 린트
  npm run lint || exit 1

  echo "✅ All checks passed!"
fi

# release 브랜치: 직접 푸시 금지
if [ "$BRANCH" = "release" ]; then
  echo "⛔ Direct push to release is not allowed!"
  echo "Please create a PR from main to release."
  exit 1
fi
